# cash-bite-backend 주소 — 서버 전용(브라우저는 /api/be 프록시 경유). NEXT_PUBLIC_ 금지.
API_BASE_URL=http://localhost:3000

# 백엔드와 공유하는 내부 키(openssl rand -hex 32). 서버 구간에서만 x-internal-key 로 부착된다.
# 로컬은 비워두면 백엔드도 검사를 건너뛴다. 운영은 Railway 의 INTERNAL_API_KEY 와 동일 값.
INTERNAL_API_KEY=

# 사이트 절대 URL — canonical·OG·sitemap·robots 기준. 배포 도메인으로 반드시 설정.
NEXT_PUBLIC_SITE_URL=https://ants-up.com

# Google Tag Manager container ID (format: GTM-XXXXXXX)
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_KEY=

# Google Search Console 소유확인 메타 태그 값 (선택)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google AdSense 퍼블리셔 ID (format: ca-pub-XXXXXXXXXXXXXXXX) — 승인 후 설정
NEXT_PUBLIC_ADSENSE_CLIENT=
