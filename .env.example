# cash-bite-backend API base URL (local dev: http://localhost:3000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# 사이트 절대 URL — canonical·OG·sitemap·robots 기준. 배포 도메인으로 반드시 설정.
NEXT_PUBLIC_SITE_URL=https://ants-up.com

# Google Tag Manager container ID (format: GTM-XXXXXXX)
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_KEY=

# Google Search Console 소유확인 메타 태그 값 (선택)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google AdSense 퍼블리셔 ID (format: ca-pub-XXXXXXXXXXXXXXXX) — 승인 후 설정
NEXT_PUBLIC_ADSENSE_CLIENT=
